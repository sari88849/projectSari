{
  "ConnectionStrings": {
    "ValidationDb": "Server=.;Database=ValidationSystemDb;Trusted_Connection=True;TrustServerCertificate=True;Application Name=ValidationSystem.Api"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "ExecutionUser": "validation_reader"
  },
  "Validation": {
    "MaxStoredResults": 5000
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
